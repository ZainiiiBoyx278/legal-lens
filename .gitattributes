# Keep classifier dataset/artifact hashes stable across Windows and Linux.
backend/app/data/classification/*.json text eol=lf

# Preserve the byte-level identities of frozen evaluation artifacts.
backend/evaluation/retrieval/questions.json -text
backend/evaluation/retrieval_v2/*.json -text
backend/evaluation/retrieval_v2/baselines/retrieval_v1.py -text

# Keep large raw experiment traces available without crowding the code review.
backend/evaluation/retrieval_v2/development*.json linguist-generated=true
backend/evaluation/retrieval_v2/holdout-retrieval.json linguist-generated=true
backend/evaluation/retrieval_v2/holdout-generation*.json linguist-generated=true
